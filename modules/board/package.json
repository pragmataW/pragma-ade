    "./renderer": "./src/renderer/index.tsx",
    "./testing": "./testing/index.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@pragma/module-agent-status": "workspace:*",
    "@pragma/module-agents": "workspace:*",
    "@pragma/module-projects": "workspace:*",
    "@pragma/sdk": "workspace:*",
    "@pragma/ui": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fractional-indexing": "3.2.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@pragma/module-git-changes": "workspace:*",
    "@pragma/test-support": "workspace:*",
    "@testing-library/react": "16.3.3",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
