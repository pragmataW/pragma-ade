{
  "name": "@pragma/module-board",
  "version": "0.9.2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --root ../.. modules/board/test",
    "e2e": "playwright test --config ../../playwright.config.ts modules/board/e2e"
