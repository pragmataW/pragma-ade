{
  "name": "@pragma/module-cli-integration",
  "version": "0.9.2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --root ../.. modules/cli-integration/test modules/cli-integration/packages/cli/test",
    "e2e": "playwright test --config ../../playwright.config.ts modules/cli-integration/e2e"
  },
  "pragma": {
    "id": "cli-integration",
    "kind": "feature",
    "displayNameKey": "cli-integration:module.name",
    "dependsOn": [
      "projects",
      "agents",
      "bridge"
    ],
    "optionalDependsOn": [
      "board",
      "comments"
    ],
    "core": false,
    "package": {
      "extraResources": [
        {
          "from": "packages/cli/dist/pragma.cjs",
          "to": "packages/cli/dist/pragma.cjs"
        },
        {
          "from": "skills",
          "to": "skills"
        }
      ]
    }
  },
  "exports": {
    "./contract": "./src/contract/index.ts",
    "./main": "./src/main/index.ts",
    "./renderer": "./src/renderer/index.tsx",
    "./testing": "./testing/index.ts"
  },
  "dependencies": {
    "@pragma/module-agents": "workspace:*",
    "@pragma/module-board": "workspace:*",
    "@pragma/module-bridge": "workspace:*",
    "@pragma/module-comments": "workspace:*",
    "@pragma/module-projects": "workspace:*",
    "@pragma/sdk": "workspace:*",
    "@pragma/ui": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@pragma/module-git-changes": "workspace:*",
    "@pragma/test-support": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
