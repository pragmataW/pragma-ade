{
  "name": "pragma-bridge",
  "displayName": "Pragma Bridge",
  "description": "Connects the Pragma ADE editor to the app: line comments to agents, open file at line, theme sync.",
  "publisher": "pragma",
  "version": "0.10.0",
  "private": true,
  "license": "MIT",
  "repository": "local:pragma-ade/modules/editor/packages/bridge-extension",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configurationDefaults": {
      "window.autoDetectColorScheme": true,
      "workbench.preferredDarkColorTheme": "Dark Modern",
      "workbench.preferredLightColorTheme": "Light Modern"
    },
    "iconThemes": [
      {
        "id": "pragma-material-icons",
        "label": "Material Icons (Pragma)",
        "path": "./icon-theme/dist/material-icons.json"
      }
    ],
    "commands": [
      {
        "command": "pragma.comment.sendToAgent",
        "title": "Send now"
      },
      {
        "command": "pragma.comment.addToReview",
        "title": "Add to drafts"
      },
      {
        "command": "pragma.comment.cancel",
        "title": "Cancel"
      },
      {
        "command": "pragma.thread.reply",
        "title": "Reply"
      },
      {
        "command": "pragma.thread.replyAndSend",
        "title": "Reply and send"
      },
      {
        "command": "pragma.thread.replyCancel",
        "title": "Cancel"
      },
      {
        "command": "pragma.thread.resolve",
        "title": "Resolve",
        "icon": "$(check)"
      },
      {
        "command": "pragma.thread.reopen",
        "title": "Reopen",
        "icon": "$(discard)"
      },
      {
        "command": "pragma.thread.delete",
        "title": "Delete Thread",
        "icon": "$(trash)"
      },
      {
        "command": "pragma.thread.discard",
        "title": "Discard",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "comments/commentThread/context": [
        {
          "command": "pragma.comment.addToReview",
          "group": "inline@1",
          "when": "commentController == pragma-review && commentThreadIsEmpty"
        },
        {
          "command": "pragma.comment.sendToAgent",
          "group": "inline@2",
          "when": "commentController == pragma-review && commentThreadIsEmpty"
        },
        {
          "command": "pragma.comment.cancel",
          "group": "inline@3",
          "when": "commentController == pragma-review && commentThreadIsEmpty"
        },
        {
          "command": "pragma.thread.reply",
          "group": "inline@1",
          "when": "commentController == pragma-review && !commentThreadIsEmpty"
        },
        {
          "command": "pragma.thread.replyAndSend",
          "group": "inline@2",
          "when": "commentController == pragma-review && !commentThreadIsEmpty"
        },
        {
          "command": "pragma.thread.replyCancel",
          "group": "inline@3",
          "when": "commentController == pragma-review && !commentThreadIsEmpty"
        }
      ],
      "commandPalette": [
        {
          "command": "pragma.comment.sendToAgent",
          "when": "false"
        },
        {
          "command": "pragma.comment.addToReview",
          "when": "false"
        },
        {
          "command": "pragma.comment.cancel",
          "when": "false"
        },
        {
          "command": "pragma.thread.reply",
          "when": "false"
        },
        {
          "command": "pragma.thread.replyAndSend",
          "when": "false"
        },
        {
          "command": "pragma.thread.replyCancel",
          "when": "false"
        },
        {
          "command": "pragma.thread.resolve",
          "when": "false"
        },
        {
          "command": "pragma.thread.reopen",
          "when": "false"
        },
        {
          "command": "pragma.thread.delete",
          "when": "false"
        },
        {
          "command": "pragma.thread.discard",
          "when": "false"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "pragma.thread.resolve",
          "group": "inline@1",
          "when": "commentController == pragma-review && commentThread == pragma-thread-open"
        },
        {
          "command": "pragma.thread.reopen",
          "group": "inline@1",
          "when": "commentController == pragma-review && commentThread == pragma-thread-resolved"
        },
        {
          "command": "pragma.thread.delete",
          "group": "inline@2",
          "when": "commentController == pragma-review && commentThread =~ /^pragma-thread-(open|resolved)$/"
        },
        {
          "command": "pragma.thread.discard",
          "group": "inline@1",
          "when": "commentController == pragma-review && commentThread == pragma-thread-unsent"
        }
      ]
    }
  },
  "scripts": {
    "build:vsix": "node build.mjs",
    "test": "vitest run --root ../../../.. modules/editor/packages/bridge-extension/test"
  },
  "pragma": {
    "build": "build:vsix",
    "buildInputs": [
      "src/**",
      "build.mjs",
      "package.json",
      "LICENSE",
      "README.md",
      "../../src/contract/**",
      "../../../comments/src/contract/**",
      "../../../bridge/src/client/**",
      "../../../bridge/src/contract/**"
    ],
    "buildOutputs": [
      "dist/pragma-bridge.vsix",
      "dist/manifest.json"
    ]
  },
  "devDependencies": {
    "@pragma/module-bridge": "workspace:*",
    "@pragma/module-editor": "workspace:*",
    "@pragma/sdk": "workspace:*",
    "@types/vscode": "1.90.0",
    "@types/ws": "8.18.2",
    "@types/yazl": "3.3.1",
    "esbuild": "0.28.2",
    "material-icon-theme": "5.40.0",
    "vitest": "5.0.5",
    "ws": "8.22.0",
    "yazl": "3.3.1"
  }
}
