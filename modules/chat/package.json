{
  "name": "@pragma/module-chat",
  "version": "0.9.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test": "vitest run --root ../.. modules/chat/test",
    "e2e": "playwright test --config ../../playwright.config.ts modules/chat/e2e"
  },
  "pragma": {
    "id": "chat",
    "kind": "feature",
    "displayNameKey": "chat:module.name",
    "dependsOn": [
      "agents",
      "projects"
    ],
    "optionalDependsOn": [
      "agent-status"
    ],
    "core": false
  },
  "exports": {
    "./contract": "./src/contract/index.ts",
    "./main": "./src/main/index.ts",
    "./renderer": "./src/renderer/index.tsx",
    "./testing": "./testing/index.ts"
  },
  "dependencies": {
    "@pierre/diffs": "1.6.2",
    "@pragma/module-agent-status": "workspace:*",
    "@pragma/module-agents": "workspace:*",
    "@pragma/module-projects": "workspace:*",
    "@pragma/sdk": "workspace:*",
    "@pragma/ui": "workspace:*",
    "@tanstack/react-virtual": "3.14.24",
    "lucide-react": "1.66.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@pragma/test-support": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": "19.3.1"
  }
}
