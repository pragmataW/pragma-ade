{
  "name": "@pragma/module-terminal",
  "version": "0.9.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node packages/pty-daemon/scripts/build.mjs",
    "test": "vitest run --root ../.. modules/terminal/test"
  },
  "pragma": {
    "id": "terminal",
    "kind": "feature",
    "displayNameKey": "terminal:module.name",
    "dependsOn": [
      "projects"
    ],
    "optionalDependsOn": [],
    "core": false,
    "build": "build",
    "buildInputs": [
      "package.json",
      "packages/pty-daemon/src/**",
      "packages/pty-daemon/scripts/**",
      "packages/pty-daemon/package.json"
    ],
    "buildOutputs": [
      "packages/pty-daemon/dist/pty-daemon.cjs"
    ],
    "package": {
      "extraResources": [
        {
          "from": "packages/pty-daemon/dist",
          "to": "packages/pty-daemon/dist"
        }
      ]
    }
  },
  "exports": {
    "./contract": "./src/contract/index.ts",
    "./main": "./src/main/index.ts",
    "./renderer": "./src/renderer/index.tsx"
  },
  "dependencies": {
    "@pragma/module-projects": "workspace:*",
    "@pragma/sdk": "workspace:*",
    "@pragma/terminal-pty-daemon": "workspace:*",
    "@pragma/ui": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "react-resizable-panels": "4.16.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@pragma/test-support": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@xterm/headless": "6.0.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": "19.3.1"
  }
}
