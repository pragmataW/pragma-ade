{
  "name": "pragma-ade",
  "version": "0.10.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint:biome": "biome check .",
    "lint:dup": "jscpd .",
    "lint:literals": "node scripts/check-literals.ts",
    "lint:arch": "vitest run --project node test/architecture",
    "lint": "pnpm lint:biome && pnpm lint:dup && pnpm lint:literals && pnpm lint:arch",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.dom-test.json",
    "pretypecheck": "pnpm gen -- --no-build",
    "test": "vitest run",
    "pretest": "pnpm gen",
    "e2e": "playwright test --grep-invert @real-agent",
    "pree2e": "node scripts/build-e2e.ts",
    "e2e:real": "node scripts/build-e2e.ts && playwright test --grep @real-agent",
    "gen": "node scripts/gen-modules.ts",
    "icons": "sh scripts/make-icons.sh",
    "dev": "pnpm --filter @pragma/desktop dev",
    "predev": "pnpm gen",
    "build": "pnpm --filter @pragma/desktop build",
    "prebuild": "pnpm gen",
    "package:mac": "node scripts/package/index.ts mac",
    "package:linux": "node scripts/package/index.ts linux",
    "package:win": "node scripts/package/index.ts win",
    "package:all": "node scripts/package/index.ts all"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@pragma/module-settings-general": "workspace:*",
    "@pragma/sdk": "workspace:*",
    "@pragma/test-support": "workspace:*",
    "@pragma/ui": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "i18next": "26.6.0",
    "jscpd": "5.4.2",
    "jsdom": "30.1.3",
    "oxc-parser": "0.156.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "tinyglobby": "0.2.17",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
