{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "apps/desktop/src/main/**/*",
    "apps/desktop/src/preload/**/*",
    "apps/desktop/src/constants.ts",
    "apps/desktop/src/generated/modules.main.ts",
    "apps/desktop/vite/**/*.ts",
    "apps/desktop/test/**/*.ts",
    "apps/desktop/e2e/**/*.ts",
    "apps/desktop/*.ts",
    "packages/sdk/src/common/**/*",
    "packages/sdk/src/main/**/*",
    "packages/sdk/src/db/**/*",
    "packages/sdk/src/runtime/main/**/*",
    "packages/sdk/src/runtime/shared/**/*",
    "packages/sdk/src/constants.ts",
    "packages/sdk/test/**/*.ts",
    "packages/ui/src/constants/**/*",
    "packages/ui/test/**/*.ts",
    "packages/test-support/src/node/**/*",
    "packages/test-support/src/e2e/**/*",
    "packages/*/e2e/**/*.ts",
    "modules/*/src/contract/**/*",
    "modules/*/src/main/**/*",
    "modules/*/src/lib/**/*",
    "modules/*/src/constants.ts",
    "modules/*/test/**/*.ts",
    "modules/*/e2e/**/*.ts",
    "modules/*/testing/**/*.ts",
    "modules/*/packages/*/src/**/*",
    "providers/*/src/main/**/*",
    "providers/*/src/constants.ts",
    "providers/*/test/**/*.ts",
    "providers/*/e2e/**/*.ts",
    "providers/*/testing/**/*.ts",
    "providers/*/packages/*/src/**/*",
    "test/architecture/fixtures/extension-proof/modules/*/src/contract/**/*",
    "test/architecture/fixtures/extension-proof/modules/*/src/main/**/*",
    "test/architecture/fixtures/extension-proof/modules/*/src/lib/**/*",
    "test/architecture/fixtures/extension-proof/modules/*/src/constants.ts",
    "test/architecture/fixtures/extension-proof/providers/*/src/main/**/*",
    "test/architecture/fixtures/extension-proof/providers/*/src/constants.ts",
    "scripts/**/*",
    "test/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["test/architecture/fixtures/violations/**/*", "scripts/test/fixtures/**", "**/node_modules/**"]
}
